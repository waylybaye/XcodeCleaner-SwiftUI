    "analysis.simulators.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your apps' data are stored here. I suggest you run `xcrun simctl delete unavailable` to reduce the size safely."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de seus aplicativos são armazenados aqui. É sugerido executar `xcrun simctl delete unavailable` para reduzir o tamanho com segurança."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "apps' data ของคุณเก็บไว้ที่นี่ ฉันแนะนำว่าคุณควรรันคำสั่ง `xcrun simctl delete unavailable` แทน เพื่อลบไฟล์อย่างปลอดภัย"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟器中安装应用的数据保存在这里，建议使用 `xcrun simctl delete unavailable` 自动清理。"
          }
        }
      }
    },
