{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "analysis.archives.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't debug deployed versions if you remove old archives."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não pode depurar versões implantadas se remover arquivos antigos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าคุณลบ archives เก่า คุณอาจไม่สามารถกลับมา Debug เวอร์ชั่นที่ถูกปล่อยไปแล้วได้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用每个版本的归档文件，收集到崩溃日志后需要其中的 dSYM 文件来定位源代码，dSYM 也可以通过开发者后台来下载，所以根据个人需要决定是否保留。"
          }
        }
      }
    },
    "analysis.derivedData.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's safe to clear the entire folder, but you'll need to rebuild your projects after removal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É seguro limpar a pasta inteira, mas você precisará rebuildar seus projetos após a remoção."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฟลเดอร์นี้สามารถลบทิ้ง ทั้งโฟลเดอร์ได้อย่างปลอดภัย คุณเพียงสั่ง rebuild โปรเจคของคุณอีกครั้ง ทุกอย่างก็จะกลับมาปรกติ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目的一些索引及缓存文件，可以安全删除，删除后再次打开项目时会自动重新生成。"
          }
        }
      }
    },
    "analysis.iOSDeviceSupport.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only need to keep the latest iOS version, feel free to remove old versions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só precisa manter a última versão do iOS, fique à vontade para remover as versões antigas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS เวอร์ชั่นล่าสุดเท่านั้นที่จะถูกใช้ คุณสามารถลบเวอร์ชั่นเก่าได้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 真机调试文件，设备通过 USB 连接时会自动生成对应系统版本的调试信息，只需要保留您持有的设备当前的最新版本即可。"
          }
        }
      }
    },
    "analysis.previews.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SwiftUI Previews simulator and data. I suggest you run `xcrun simctl --set previews delete unavailable` to reduce the size safely."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados e SwiftUI simulator Previews"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SwiftUI Previews simulator and data"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SwiftUI 预览的模拟器和数据，建议使用 `xcrun simctl --set previews delete unavailable` 自动清理。"
          }
        }
      }
    },
    "analysis.simulatorCaches.summary" : {
      "extractionState" : "manual",
